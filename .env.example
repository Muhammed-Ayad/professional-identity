# ==============================================================================
# Professional Identity — Production Environment Variables Reference
# ==============================================================================
# Copy this file to .env or inject these variables into your container/cloud runner.
# Do NOT commit real credentials or production passwords to version control.

# ------------------------------------------------------------------------------
# 1. Serverpod Core & Run Mode
# ------------------------------------------------------------------------------
SERVERPOD_RUN_MODE=production
SERVERPOD_LOGGING_MODE=normal

# ------------------------------------------------------------------------------
# 2. Serverpod API Server Configuration
# ------------------------------------------------------------------------------
SERVERPOD_API_SERVER_PORT=8080
SERVERPOD_API_SERVER_PUBLIC_HOST=api.professionalidentity.dev
SERVERPOD_API_SERVER_PUBLIC_PORT=443
SERVERPOD_API_SERVER_PUBLIC_SCHEME=https

# ------------------------------------------------------------------------------
# 3. Serverpod Web Server Configuration (SEO, Health, Web App)
# ------------------------------------------------------------------------------
SERVERPOD_WEB_SERVER_PORT=8082
SERVERPOD_WEB_SERVER_PUBLIC_HOST=app.professionalidentity.dev
SERVERPOD_WEB_SERVER_PUBLIC_PORT=443
SERVERPOD_WEB_SERVER_PUBLIC_SCHEME=https

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
SERVERPOD_DATABASE_HOST=database.internal.production.domain
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=professional_identity
SERVERPOD_DATABASE_USER=postgres
SERVERPOD_DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
SERVERPOD_DATABASE_REQUIRE_SSL=true

# ------------------------------------------------------------------------------
# 5. Security & Authentication Secrets (Required for JWT & Email IDP)
# ------------------------------------------------------------------------------
SERVERPOD_PASSWORD_serviceSecret=GENERATE_RANDOM_32_CHAR_STRING_FOR_SERVICE_SECRET
SERVERPOD_PASSWORD_emailSecretHashPepper=GENERATE_RANDOM_32_CHAR_STRING_FOR_EMAIL_PEPPER
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=GENERATE_RANDOM_32_CHAR_STRING_FOR_JWT_KEY
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=GENERATE_RANDOM_32_CHAR_STRING_FOR_REFRESH_PEPPER

# ------------------------------------------------------------------------------
# 6. Flutter Client Build-Time Defines (Pass via --dart-define)
# ------------------------------------------------------------------------------
# E.g.: flutter build web --release \
#         --dart-define=SERVER_URL=https://api.professionalidentity.dev/ \
#         --dart-define=PUBLIC_BASE_URL=https://app.professionalidentity.dev
SERVER_URL=https://api.professionalidentity.dev/
PUBLIC_BASE_URL=https://app.professionalidentity.dev
